diff --git a/apps/desktop/ui/src/lib/miniPreviewsHidden.ts b/apps/desktop/ui/src/lib/miniPreviewsHidden.ts
index b09d306..ce33358 100644
--- a/apps/desktop/ui/src/lib/miniPreviewsHidden.ts
+++ b/apps/desktop/ui/src/lib/miniPreviewsHidden.ts
@@ -14,8 +14,12 @@ export function miniPreviewsHiddenLabel(count: number): string {
 /** Compact folder control dimensions in the thumbnail window. */
 export const MINI_PREVIEW_FOLDER_SIZE_PX = 40;
 
-/** Hold the folder together until the outgoing card reaches its top-right edge. */
-export const MINI_PREVIEW_FOLDER_DUST_LEAD_MS = 420;
+/**
+ * Hold the folder together until the outgoing card's ash front reaches it.
+ * 50ms earlier than the previous 420ms hold so the icon starts breaking as
+ * the preview wave blows past, instead of sitting fully formed.
+ */
+export const MINI_PREVIEW_FOLDER_DUST_LEAD_MS = 370;
 
 /** A shorter copy of the card dissolve wave, scaled to the compact control. */
 export const MINI_PREVIEW_FOLDER_DUST_WAVE_MS = 420;
diff --git a/apps/desktop/ui/src/lib/thumbnailLayout.test.ts b/apps/desktop/ui/src/lib/thumbnailLayout.test.ts
