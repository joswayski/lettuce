 apps/desktop/ui/src/App.tsx                   |  4 ++
 .../ui/src/MiniPreviewsHidden.test.tsx        | 17 +++++-
 apps/desktop/ui/src/Thumbnail.test.tsx        |  5 +-
 apps/desktop/ui/src/ThumbnailCard.test.tsx    | 23 ++++++++
 .../ui/src/lib/miniPreviewsHidden.test.ts     |  1 +
 apps/desktop/ui/src/lib/miniPreviewsHidden.ts |  8 ++-
 .../ui/src/lib/thumbnailLayout.test.ts        | 28 +++++++++
 apps/desktop/ui/src/styles/mini-preview.css   | 57 +++++++++++++++----
 8 files changed, 127 insertions(+), 16 deletions(-)

diff --git a/apps/desktop/ui/src/App.tsx b/apps/desktop/ui/src/App.tsx
