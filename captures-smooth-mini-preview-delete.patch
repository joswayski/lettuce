--- a/apps/desktop/ui/src/lib/thumbnailLayout.test.ts
+++ b/apps/desktop/ui/src/lib/thumbnailLayout.test.ts
@@ -68,6 +68,34 @@ describe("thumbnail stack layout", () => {
 
     expect(Number(sourceLayer?.[1])).toBeGreaterThan(Number(dustLayer?.[1]));
     expect(sourceFade?.[1]).toMatch(/filter:\s*blur\(2px\) brightness\(0\.5\)/);
+    expect(sourceFade?.[1]).toMatch(/0%,\s*20%/);
+  });
+
+  it("keeps hovered delete chrome on the first dissolve frame", () => {
+    const deleteTooltip = thumbnailStyles.match(
+      /\.thumbnail-exit-delete \.icon-button\.delete::after\s*\{([^}]*)\}/,
+    );
+    const deleteHover = thumbnailStyles.match(
+      /\.thumbnail-exit-delete \.icon-button\.delete\s*\{([^}]*)\}/,
+    );
+    const disabledSave = thumbnailStyles.match(
+      /\.thumbnail-exit-delete \.thumbnail-main-actions button:disabled,\s*\.thumbnail-exit-delete \.icon-button:disabled\s*\{([^}]*)\}/,
+    );
+    const bottomBar = thumbnailStyles.match(
+      /\.thumbnail-exit-delete \.thumbnail-bottom-bar\s*\{([^}]*)\}/,
+    );
+    const dustChip = thumbnailStyles.match(
+      /\.thumbnail-dust\s*\{([^}]*)\}/,
+    );
+
+    expect(thumbnailStyles).toMatch(
+      /\.thumbnail-card\.thumbnail-exiting:not\(\.thumbnail-exit-delete\) \.icon-button::after/,
+    );
+    expect(deleteTooltip?.[1]).toMatch(/opacity:\s*1/);
+    expect(deleteHover?.[1]).toMatch(/background:\s*var\(--theme-signal\)/);
+    expect(disabledSave?.[1]).toMatch(/opacity:\s*1/);
+    expect(bottomBar?.[1]).toMatch(/z-index:\s*8/);
+    expect(dustChip?.[1]).toMatch(/filter:\s*blur\(2px\) brightness\(0\.5\)/);
   });
 
   it("fades the mini-preview frame with the delete dissolve", () => {
diff --git a/apps/desktop/ui/src/styles/mini-preview.css b/apps/desktop/ui/src/styles/mini-preview.css
index 4527073..f8b0607 100644
--- a/apps/desktop/ui/src/styles/mini-preview.css
+++ b/apps/desktop/ui/src/styles/mini-preview.css
@@ -93,6 +93,7 @@
 }
 
 .thumbnail-collapse {
+  --mini-preview-folder-dust-lead: 370ms;
   position: absolute;
   z-index: 20;
   top: auto;
@@ -318,7 +319,7 @@
 }
 
 .thumbnail-collapse.thumbnail-collapse-leaving {
-  animation: thumbnail-folder-source-fade 0.18s 0.42s linear both;
+  animation: thumbnail-folder-source-fade 0.18s var(--mini-preview-folder-dust-lead) linear both;
   pointer-events: none;
 }
 
@@ -349,8 +350,15 @@
   pointer-events: none;
 }
 
-.thumbnail-collapse-dust-chip {
+/*
+ * Folder chips must not inherit the card-dust brightness filter — that rule
+ * comes later and would otherwise paint a darkened plate over the live icon.
+ * Opacity stays 0 until WAAPI starts each chip so the original control remains
+ * the only visible folder during the lead-in.
+ */
+.thumbnail-collapse-dust-layer .thumbnail-collapse-dust-chip {
   filter: none;
+  opacity: 0;
 }
 
 .thumbnail-collapse-dust-surface {
@@ -362,13 +370,14 @@
   padding: 0 6px;
   align-items: center;
   gap: var(--s-3);
-  border: 1px solid var(--glass-border);
+  /* Transparent replica of the 40px control: keep padding/border so the
+     yellow icon and check badge sit on the same pixels as the live button,
+     without stacking a second dark glass plate over it. */
+  border: 1px solid transparent;
   border-radius: var(--r-xl);
   color: var(--glass-text);
-  background: var(--glass-strong-solid);
-  box-shadow:
-    inset 0 1px 0 rgba(255, 255, 255, 0.07),
-    0 1px 3px rgba(0, 0, 0, 0.46);
+  background: transparent;
+  box-shadow: none;
   overflow: hidden;
   pointer-events: none;
 }
@@ -1381,8 +1390,8 @@ html.thumbnail-native-tracking[data-thumbnail-cursor] :is(.thumbnail-collapse, .
   cursor: default !important;
 }
 
-.thumbnail-card.thumbnail-exiting .icon-button::after,
-.thumbnail-card.thumbnail-exiting .thumbnail-editor-control-tip {
+.thumbnail-card.thumbnail-exiting .thumbnail-editor-control-tip,
+.thumbnail-card.thumbnail-exiting:not(.thumbnail-exit-delete) .icon-button::after {
   opacity: 0 !important;
   transition: none !important;
 }
@@ -1534,10 +1543,33 @@ html.thumbnail-native-tracking[data-thumbnail-cursor] :is(.thumbnail-collapse, .
 }
 
 .thumbnail-exit-delete .thumbnail-bottom-bar {
+  z-index: 8;
   transition: none !important;
 }
 
-.thumbnail-exit-delete .icon-button::after,
+/*
+ * Clicking Delete clears :hover / native pointer hover (inert + click-through).
+ * Freeze the hovered delete chrome so the first dissolve frame matches the
+ * screenshot the user was looking at — tooltip, red trash, and opaque Save.
+ */
+.thumbnail-exit-delete .icon-button.delete {
+  color: #fff;
+  background: var(--theme-signal);
+  transform: translateY(-1px) scale(1.04);
+}
+
+.thumbnail-exit-delete .icon-button.delete::after {
+  opacity: 1;
+  transform: translate(0, 0);
+  transition: none;
+}
+
+.thumbnail-exit-delete .thumbnail-main-actions button:disabled,
+.thumbnail-exit-delete .icon-button:disabled {
+  opacity: 1;
+  cursor: default;
+}
+
 .thumbnail-exit-delete .thumbnail-editor-control-tip {
   opacity: 0 !important;
   transition: none !important;
@@ -1608,7 +1640,8 @@ html.thumbnail-native-tracking[data-thumbnail-cursor] :is(.thumbnail-collapse, .
 }
 
 @keyframes thumbnail-delete-img-fade {
-  0% {
+  0%,
+  20% {
     opacity: 1;
     filter: blur(2px) brightness(0.5);
     transform: scale(1.015);
@@ -1650,7 +1683,7 @@ html.thumbnail-native-tracking[data-thumbnail-cursor] :is(.thumbnail-collapse, .
   display: block;
   border-radius: 0;
   overflow: hidden;
-  filter: brightness(0.5);
+  filter: blur(2px) brightness(0.5);
   opacity: 1;
   transform: translate3d(0, 0, 0) rotate(0deg) scale(1);
   box-shadow: none;
