       /\.thumbnail-collapse\.thumbnail-collapse-leaving\s*\{([\s\S]*?)\n\}/,
     );
 
-    expect(exitRule?.[1]).toMatch(/thumbnail-folder-source-fade 0\.18s 0\.42s/);
+    expect(exitRule?.[1]).toMatch(
